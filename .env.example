# Salin menjadi .env.local lalu isi (file .env* selain contoh ini diabaikan git).
# Nilai diambil dari Supabase Dashboard > Project Settings > API (proyek DEV).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alamat Session pooler (Connect > Session pooler) untuk migrasi via `pnpm db ...`; berisi password.
SUPABASE_DB_URL=
# Session pooler proyek PRODUCTION, hanya untuk `pnpm db:prod db push` dari laptop (ADR 018).
# Tidak pernah diisi di Vercel.
SUPABASE_PROD_DB_URL=
# Opsional: `mock` untuk memakai data contoh Fase 1 (tanpa login).
# NEXT_PUBLIC_DATA_SOURCE=mock
# Opsional: `false` menyembunyikan halaman Daftar (production setelah akun pemilik dibuat).
# NEXT_PUBLIC_ALLOW_SIGNUP=false
# Dilarang menambahkan service role key di sini (AGENTS.md).
