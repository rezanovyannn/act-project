# Salin menjadi .env.local lalu isi (file .env* selain contoh ini diabaikan git).
# Nilai diambil dari Supabase Dashboard > Project Settings > API (proyek DEV).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alamat Session pooler (Connect > Session pooler) untuk migrasi via `pnpm db ...`; berisi password.
SUPABASE_DB_URL=
# Opsional: `mock` untuk memakai data contoh Fase 1 (tanpa login).
# NEXT_PUBLIC_DATA_SOURCE=mock
# Dilarang menambahkan service role key di sini (AGENTS.md).
